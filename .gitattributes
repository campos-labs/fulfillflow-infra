* text=auto
*.md text eol=lf
*.tf text eol=lf
*.hcl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.example text eol=lf
*.conf text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Preserve evidence bytes and declared SHA-256 across checkout/commit.
docs/evidence/operational-a/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

docs/evidence/scaling/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/assets/scaling/*.svg text eol=lf

# Published observability captures retain their original bytes.
docs/evidence/observability/records/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

docs/evidence/observability/http-05/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

docs/evidence/observability/http-errors/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

docs/evidence/observability/http-fault-03/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Reproducible offline bundles and diagrams.
docs/evidence/observability/archives/*.zip binary
docs/assets/observability/*.svg text eol=lf
docs/evidence/observability/archives/*.sha256 text eol=lf

# AKS evidence hashes and reproducible package inputs.
docs/evidence/aks-portability/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/assets/aks-portability/*.svg -text
