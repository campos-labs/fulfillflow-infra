# SYNTHETIC backend identifiers. Never add access_key, sas_token or client_secret.
subscription_id      = "00000000-0000-0000-0000-000000000000"
tenant_id            = "11111111-1111-1111-1111-111111111111"
resource_group_name  = "rg-ff-example-state"
storage_account_name = "ffexamplestate0001"
container_name       = "tfstate"
key                  = "environment.tfstate"
use_azuread_auth     = true
# Human bootstrap may use a separately authenticated Azure CLI session.
# Future provisioning automation must use its own authorized OIDC identity.
